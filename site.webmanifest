{
  "name": "Fly to The End",
  "short_name": "FlyToEnd",
  "description": "Game phiêu lưu lái máy bay 3D đưa bạn qua các di tích lịch sử Việt Nam với 7 tầng thử thách theo các cấp độ và 3 chế độ điều khiển độc đáo",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#dbe4c6",
  "theme_color": "#f25346",
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "16x16 24x24 32x32 48x48 64x64",
      "type": "image/x-icon"
    },
    {
      "src": "assets/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/icons/game-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
